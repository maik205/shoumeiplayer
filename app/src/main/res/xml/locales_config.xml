<?xml version="1.0" encoding="utf-8"?>
<!--
  Locales offered in Android's per-app language setting. A tag here must have a matching
  values-<qualifier> directory with a complete translation: declaring one without it makes every
  string report as missing and fails lint. Keep in sync with DisplayLanguage.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="ja" />
    <locale android:name="ko" />
    <locale android:name="pt-BR" />
    <locale android:name="vi" />
    <locale android:name="zh-CN" />
</locale-config>
