<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) cloud backup and device-to-device transfer rules. Excludes the same
  session DataStore as backup_rules.xml (the API <=30 equivalent) so access tokens and
  remembered-server credentials never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/shoumei_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/shoumei_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
